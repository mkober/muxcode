{
  "env": {
    "CLAUDE_CODE_NO_FLICKER": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "muxcode hook guard"
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "muxcode hook guard"
          },
          {
            "type": "command",
            "command": "muxcode-preview-hook.sh",
            "async": true
          }
        ]
      },
      {
        "matcher": "Read|Bash|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "muxcode-diff-cleanup.sh",
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "muxcode hook analyze",
            "async": true
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "muxcode hook bash",
            "async": true
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "muxcode hook comment-block"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "muxcode hook stop"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(muxcode *)",
      "Bash(./bin/muxcode *)",
      "Bash(muxcode compact*)",
      "Bash(muxcode atlassian *)",
      "Bash(SESSION=* && tmux capture-pane *)",
      "Bash(SESSION=* && tmux display-message *)",
      "Bash(SESSION=* && for role in *)",
      "Bash(SESSION=* && idle=*)",
      "Bash(SESSION=*; tmux capture-pane *)",
      "Bash(SESSION=*; tmux display-message *)",
      "Bash(SESSION=*; for role in *)",
      "Bash(SESSION=*; idle=*)",
      "Bash(SESSION=*; output=*)",
      "Bash(SESSION=*; echo *)",
      "Bash(SESSION=*; pane=*)",
      "Bash(SESSION=* tmux capture-pane *)",
      "Bash(SESSION=* tmux display-message *)",
      "Bash(tmux capture-pane *)",
      "Bash(tmux display-message *)",
      "Bash(tmux list-windows *)",
      "Bash(tmux list-panes *)",
      "Bash(tmux select-window *)",
      "Bash(tmux show-options *)",
      "Bash(for role in *; do *tmux capture-pane*)",
      "Bash(for w in *tmux list-windows*)",
      "Bash(for pane in *tmux list-panes*)",
      "Bash(cat /tmp/muxcode-*)",
      "Bash(cat /private/tmp/muxcode-*)",
      "Bash(ls *)",
      "Bash(which *)",
      "Bash(git branch*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git stash list*)",
      "Bash(git status*)",
      "Bash(git push*)",
      "Bash(git push --force-with-lease*)",
      "Bash(go build*)",
      "Bash(go test*)",
      "Bash(go vet*)",
      "Bash(node --version*)",
      "Bash(npx cdk *)",
      "Bash(npx jest*)",
      "Bash(pnpm install*)",
      "Bash(pnpm run build*)",
      "Bash(pnpm run lint*)",
      "Bash(pnpm run test*)",
      "Bash(pytest*)",
      "Bash(python -m pytest*)",
      "Bash(python3 --version*)",
      "Bash(ruff *)",
      "Bash(aws cloudformation describe-stacks*)",
      "Bash(aws cloudformation list-stacks*)",
      "Bash(aws dynamodb describe-table*)",
      "Bash(aws dynamodb get-item*)",
      "Bash(aws dynamodb query*)",
      "Bash(aws dynamodb scan*)",
      "Bash(aws events describe-rule*)",
      "Bash(aws events list-rules*)",
      "Bash(aws events list-targets*)",
      "Bash(aws glue get-job*)",
      "Bash(aws glue get-job-run*)",
      "Bash(aws glue list-jobs*)",
      "Bash(aws lambda get-function*)",
      "Bash(aws lambda invoke*)",
      "Bash(aws lambda list-functions*)",
      "Bash(aws logs describe-log-groups*)",
      "Bash(aws logs filter-log-events*)",
      "Bash(aws logs get-log-events*)",
      "Bash(aws logs tail*)",
      "Bash(aws s3 cp*)",
      "Bash(aws s3 ls*)",
      "Bash(aws sns *)",
      "Bash(aws sqs *)",
      "Bash(aws ssm get-parameter*)",
      "Bash(aws stepfunctions describe-execution*)",
      "Bash(aws stepfunctions get-execution-history*)",
      "Bash(aws stepfunctions list-executions*)",
      "Bash(aws stepfunctions list-state-machines*)",
      "Bash(aws stepfunctions start-execution*)",
      "Bash(aws sts get-caller-identity*)",
      "Bash(az account show*)",
      "Bash(az functionapp list*)",
      "Bash(az functionapp show*)",
      "Bash(az group list*)",
      "Bash(az group show*)",
      "Bash(az keyvault secret show*)",
      "Bash(az monitor log-analytics query*)",
      "Bash(az resource list*)",
      "Bash(az resource show*)",
      "Bash(az servicebus queue *)",
      "Bash(az servicebus topic *)",
      "Bash(az sql db list*)",
      "Bash(az sql db show*)",
      "Bash(az storage blob *)",
      "Bash(az storage container list*)",
      "Bash(az webapp list*)",
      "Bash(az webapp show*)",
      "Bash(cdk diff*)",
      "Bash(cdk ls*)",
      "Bash(cdk synth*)",
      "Bash(docker inspect*)",
      "Bash(docker logs*)",
      "Bash(docker ps*)",
      "Bash(envName=* cdk *)",
      "Bash(envName=* npx cdk *)",
      "Bash(gcloud app describe*)",
      "Bash(gcloud app services list*)",
      "Bash(gcloud compute instances describe*)",
      "Bash(gcloud compute instances list*)",
      "Bash(gcloud config get-value*)",
      "Bash(gcloud config list*)",
      "Bash(gcloud functions describe*)",
      "Bash(gcloud functions list*)",
      "Bash(gcloud functions logs read*)",
      "Bash(gcloud logging read*)",
      "Bash(gcloud projects describe*)",
      "Bash(gcloud projects list*)",
      "Bash(gcloud pubsub subscriptions list*)",
      "Bash(gcloud pubsub topics list*)",
      "Bash(gcloud pubsub topics publish*)",
      "Bash(gcloud run services describe*)",
      "Bash(gcloud run services list*)",
      "Bash(gcloud sql instances describe*)",
      "Bash(gcloud sql instances list*)",
      "Bash(gcloud storage cp*)",
      "Bash(gcloud storage ls*)",
      "Bash(gsutil cp*)",
      "Bash(gsutil ls*)",
      "Bash(kubectl describe*)",
      "Bash(kubectl get*)",
      "Bash(kubectl logs*)",
      "Bash(terraform output*)",
      "Bash(terraform plan*)",
      "Bash(terraform show*)",
      "Bash(terraform state list*)",
      "Bash(terraform state show*)",
      "Read(/tmp/muxcode-*)",
      "Read(/private/tmp/muxcode-*)",
      "Edit(/tmp/muxcode-*)",
      "Edit(/private/tmp/muxcode-*)"
    ],
    "deny": [
      "Bash(rm -rf /)*",
      "Bash(git reset --hard*)",
      "Bash(aws s3 rb*)",
      "Bash(aws s3 rm*)",
      "Bash(az group delete*)",
      "Bash(az resource delete*)",
      "Bash(az storage blob delete*)",
      "Bash(az storage container delete*)",
      "Bash(cdk destroy*)",
      "Bash(gcloud projects delete*)",
      "Bash(gcloud storage rm*)",
      "Bash(gsutil rm*)",
      "Bash(kubectl delete*)",
      "Bash(terraform destroy*)"
    ]
  }
}
