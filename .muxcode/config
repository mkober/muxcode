# muxcode project-local configuration
# Overrides global ~/.config/muxcode/config for this project.

# Edit agent: Claude Code
MUXCODE_EDIT_CLI=claude

# Review agent: OpenCode with DeepSeek V4 Pro
MUXCODE_REVIEW_CLI=opencode
MUXCODE_REVIEW_MODEL=opencode-go/deepseek-v4-pro

# Serve agent: OpenCode with MiniMax M2.5
MUXCODE_SERVE_CLI=opencode
MUXCODE_SERVE_MODEL=opencode-go/minimax-m3

MUXCODE_DEPLOY_CLI=claude

MUXCODE_DEPLOY_MODEL=claude-sonnet-4-6

MUXCODE_RUN_CLI=opencode

MUXCODE_RUN_MODEL=opencode-go/deepseek-v4-flash

MUXCODE_WATCH_CLI=opencode

MUXCODE_WATCH_MODEL=opencode-go/mimo-v2.5

MUXCODE_COMMIT_CLI=claude

MUXCODE_COMMIT_MODEL=claude-sonnet-4-6

MUXCODE_EDIT_MODEL=claude-opus-4-8

MUXCODE_AUTO_CLI=claude

MUXCODE_AUTO_MODEL=claude-opus-4-8

MUXCODE_BUILD_CLI=opencode

MUXCODE_BUILD_MODEL=opencode-go/deepseek-v4-flash

MUXCODE_TEST_CLI=opencode

MUXCODE_TEST_MODEL=opencode-go/deepseek-v4-flash

MUXCODE_ANALYZE_CLI=opencode

