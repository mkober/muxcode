<mxfile host="app.diagrams.net" type="device">
  <diagram id="sample-aws-architecture" name="AWS Architecture">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title box -->
        <mxCell id="title" value="Outbound Data Flow — Reference (generic)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="260" height="64" as="geometry" />
        </mxCell>

        <!-- Left edge: source + broker + front API Gateway -->
        <mxCell id="src" value="Source System" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="320" width="90" height="60" as="geometry" />
        </mxCell>
        <mxCell id="broker" value="Integration Broker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="140" y="320" width="90" height="60" as="geometry" />
        </mxCell>
        <mxCell id="apigwF" value="API Gateway" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;" vertex="1" parent="1">
          <mxGeometry x="270" y="312" width="70" height="70" as="geometry" />
        </mxCell>

        <!-- Raw Staging Layer boundary -->
        <mxCell id="raw" value="Raw Staging Layer&#10;Data Services Account" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=center;fontStyle=1;fontSize=13;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="380" y="130" width="440" height="470" as="geometry" />
        </mxCell>
        <mxCell id="rawdb" value="Raw DB" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#2E27AD;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="raw">
          <mxGeometry x="40" y="150" width="70" height="70" as="geometry" />
        </mxCell>
        <mxCell id="sfn1" value="Step Functions" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.step_functions;" vertex="1" parent="raw">
          <mxGeometry x="170" y="230" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="glue1" value="Glue" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.glue;" vertex="1" parent="raw">
          <mxGeometry x="240" y="230" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="procdb" value="Processed DB" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#2E27AD;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="raw">
          <mxGeometry x="320" y="150" width="70" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e_raw" value="Merge Data" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#232F3E;fontSize=11;fontStyle=1;" edge="1" parent="raw" source="rawdb" target="procdb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Enterprise Layer boundary -->
        <mxCell id="ent" value="Enterprise Layer&#10;Data Services Account" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=center;fontStyle=1;fontSize=13;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="860" y="130" width="400" height="470" as="geometry" />
        </mxCell>
        <mxCell id="entraw" value="Enterprise Raw" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#2E27AD;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="ent">
          <mxGeometry x="40" y="150" width="70" height="70" as="geometry" />
        </mxCell>
        <mxCell id="sfn2" value="Step Functions" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.step_functions;" vertex="1" parent="ent">
          <mxGeometry x="150" y="230" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="glue2" value="Glue" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.glue;" vertex="1" parent="ent">
          <mxGeometry x="215" y="230" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="entproc" value="Enterprise Processed" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#2E27AD;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="ent">
          <mxGeometry x="290" y="150" width="70" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e_ent" value="Merge Data" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#232F3E;fontSize=11;fontStyle=1;" edge="1" parent="ent" source="entraw" target="entproc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Athena between Enterprise and Export -->
        <mxCell id="athena" value="Athena" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.athena;" vertex="1" parent="1">
          <mxGeometry x="1290" y="312" width="70" height="70" as="geometry" />
        </mxCell>

        <!-- Export Layer boundary -->
        <mxCell id="exp" value="Export Layer&#10;Integration Services Account" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=center;fontStyle=1;fontSize=13;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="1400" y="130" width="560" height="470" as="geometry" />
        </mxCell>
        <!-- Nested compute group (dashed) holding Lambda + app runtime -->
        <mxCell id="compute" value="Compute" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 6;strokeColor=#666666;fillColor=none;verticalAlign=top;align=center;fontSize=11;container=1;collapsible=0;" vertex="1" parent="exp">
          <mxGeometry x="30" y="120" width="130" height="220" as="geometry" />
        </mxCell>
        <mxCell id="lambda" value="Lambda" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="compute">
          <mxGeometry x="30" y="30" width="70" height="70" as="geometry" />
        </mxCell>
        <mxCell id="apprt" value="App Runtime&#10;(3rd-party)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="compute">
          <mxGeometry x="20" y="130" width="90" height="60" as="geometry" />
        </mxCell>
        <!-- EventBridge scheduled rule -->
        <mxCell id="evb" value="Scheduled&#10;EventBridge Rule" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eventbridge;" vertex="1" parent="exp">
          <mxGeometry x="210" y="40" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="apigw2" value="API Gateway&#10;/create" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;" vertex="1" parent="exp">
          <mxGeometry x="220" y="180" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="sqs" value="SQS Queue" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.simple_queue_service_sqs;" vertex="1" parent="exp">
          <mxGeometry x="360" y="180" width="60" height="60" as="geometry" />
        </mxCell>

        <!-- External identity provider (3rd-party, generic) -->
        <mxCell id="idp" value="Identity Provider&#10;(3rd-party)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1710" y="470" width="120" height="60" as="geometry" />
        </mxCell>

        <!-- Top-level flow arrows -->
        <mxCell id="f1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#333333;" edge="1" parent="1" source="src" target="broker"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#333333;" edge="1" parent="1" source="broker" target="apigwF"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#333333;" edge="1" parent="1" source="apigwF" target="raw"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#333333;" edge="1" parent="1" source="raw" target="ent"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#333333;" edge="1" parent="1" source="ent" target="athena"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#333333;" edge="1" parent="1" source="athena" target="exp"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#333333;" edge="1" parent="1" source="exp" target="idp"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
