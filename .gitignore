firepit-log.txt
node_modules/
# Generated agent-config files. WriteAgentConfig regenerates these on every
# agent launch/reload (bus/launch.go, bus/reload.go), injecting the current
# session-memory summaries each time — so they churn constantly and carry no
# meaningful tracked content. They regenerate locally on first launch.
.opencode/agents/*.md
.codex/AGENTS.md
.codex/**/AGENTS.md

# Stray OpenCode/Codex agent configs generated by tests/dev runs with cwd
# inside a Go module.
/tools/**/.opencode/
/tools/**/.codex/
